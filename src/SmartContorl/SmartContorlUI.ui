   <item>
    <widget class="CodeEditor" name="textEdit">
     <property name="styleSheet">
      <string notr="true">font: 9pt &quot;微软雅黑&quot;;</string>
     </property>
     <property name="plainText">
      <string>require &quot;math&quot;
--声明一个参数容器
variates = {};
variateCount = 0;
pgtF = 0;
pitF = 0;
valueCount = 0;
--获取F得定义
function getF(minif,maxf,avf)
	if(fmod == 0)
	then
		return maxf;
	end
	if(fmod == 1)
	then
		return minif
	end
	if(fmod == 2)
	then
		return avf;
	end
	if(fmod == 3)
	then
		return avf*math.exp(-math.abs(maxf/avf - 2));
	end
end
--判断两个f哪一个更符合预期
--如果第一个f更符合预期 则返回true
function compareF(f1,f2)
	if(math.abs(f1 - excpectF) &lt; math.abs(f2 - excpectF))
	then
		return true;
	end
	return false;
end
--添加参数函数
function addVar(name,max,mini,count)
    local var = {};
    local i = 1;
	local v = {};
	var.vit = {};
	var.pgt = 0;
	var.pit = {};
	var.pitF = {};
    --随机数只能取整数 所以需要将范围乘上一个足够大的数之后再取小数
	local bei = 100000000;
    while(i &lt; count + 1)
	do
		--设置参数值
		v[i] = math.random(mini*bei,max*bei)/bei;
		--初始化参数的增量
		local vitV = math.abs(mini - max)/2;
		var.vit[i] = math.random(-vitV*bei,vitV*bei)/bei;
		var.pitF[i] = 0;
		var.pit[i] = 0;
		i = i + 1;
	end
    var.variate = v;
    var.name = name;
    var.max = max;
    var.mini = mini;
    variateCount = variateCount + 1;
    variates[variateCount] = var;
    valueCount = count;
end
function rand()
	return math.random();
end
function init()
 cppPrint(&quot;call init&quot;);
 local index = 1;
 while(index &lt; variateCount + 1)
 do
	--输出参数值
	local i = 1;
	local log = variates[index].name..&quot;= &quot;
	while(i &lt; valueCount + 1)
	do
		log = log..variates[index].variate[i]..&quot;,&quot;;
		i = i + 1;
	end
	cppPrint(log);
	--往c中添加变量
	addVariate(variates[index].name,variates[index].variate);
	index = index + 1;
 end
end
function resultDataFilter()
 getAllResult();
 while(nextResult())
 do
	if(not openH5File())
	then
		cppPrint(&quot;open h5file false!&quot;);
	end
	if(not findResultData(observeName))
	then
		cppPrint(&quot;find result false!&quot;);
		return;
	end
 
	if(not openDataSet())
	then
		cppPrint(&quot;open data set false!&quot;);
		return;
	end
	local valueSize = getDataSetVlaueSize();
	local i = 0;
	local max = 0;
	local mini = -999999;
	local add = 0;
	local addCount = 0;
	while(i &lt; valueSize)
	do
		local time = getValue(i);
		if(time &gt; miniTime and time &lt; maxTime)
		then
			local value = getValue(i+1);
			addCount = addCount + 1;
			add = add + value;
			if(value &gt; max)
			then
				max = value;
			end
			if(value &lt; mini)
			then
				mini = value;
			end
		end
		i = i + 2;
	end
	local av = add/addCount;
	local f = getF(mini,max,av);
	cppPrint(&quot;f= &quot;..f);
	addParam(f);
 end
 saveParamsInHistory();
 local groupIndex = getHistorySize() - 1;
 local groupSize = getGroupSize(groupIndex);
 local index = 0;
 local maxF = 0;
 local maxFIndex = 0;
 while(index &lt; groupSize)
 do
	local F = getParam(groupIndex,index,0);
	local pitF = variates[1].pitF[index + 1];
	print(&quot;pitf=&quot;..pitF);
	if(compareF(F,pitF))
	then
		local countIndex = 1;
		while(countIndex &lt; variateCount + 1)
		do
			variates[countIndex].pitF[index + 1] = F;
			print(&quot;pitf2=&quot;..variates[countIndex].pitF[index + 1]);
			variates[countIndex].pit[index + 1] = variates[countIndex].variate[index + 1];
			countIndex = countIndex + 1;
		end
    end
	if(compareF(F,pgtF))
	then
		pgtF = F;
        local tempIndex = 1;
        while(tempIndex &lt; variateCount + 1)
        do
			variates[tempIndex].pgt = variates[tempIndex].variate[index + 1];
			tempIndex = tempIndex + 1;
		end
    end
	index = index + 1;
 end
end

function resultExpcet()
 cppPrint(&quot;call result expcet&quot;);
 if(math.abs(pgtF - excpectF)&lt;30)
 then
	return true;
 end
 return false;
end
function optimize()
 cppPrint(&quot;call optimize&quot;);
 local variateIndex = 1;
 while(variateIndex &lt; variateCount + 1)
 do
     local index = 1;
     local tempVariate = variates[variateIndex];
	 while(index &lt; valueCount + 1)
	 do
        local temp = 0;
        local value = tempVariate.variate[index];
		local vit = tempVariate.vit[index];
        local pit = tempVariate.pit[index];
        local pgt = tempVariate.pgt;
        local mini = tempVariate.mini;
		local max = tempVariate.max;
		print(&quot;vi=&quot;..vit);
		print(&quot;pit=&quot;..pit);
		print(&quot;pgt=&quot;..pgt);
        temp = omiga*vit + c1*rand()*(pit - value) + c2*rand()*(pgt - value);
		tempVariate.vit[index] = temp;
        value = value + temp;
		while(value &lt; mini or value &gt; max)
		do
			if(value &lt; mini)
			then
				value = mini + math.abs(value - mini);
			else
				value = max - math.abs(max - value);
			end
		end
		tempVariate.variate[index] = value;
		index = index + 1;	
     end
     variates[variateIndex] = tempVariate;
	 variateIndex = variateIndex + 1;
 end
 init();
end</string>
