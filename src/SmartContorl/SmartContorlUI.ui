  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="CodeEditor" name="textEdit">
     <property name="plainText">
      <string>require &quot;math&quot;
RAAA = {1.5/1000,2/1000,2.5/1000,3/1000,3.5/1000,4/1000};
RBBB = {11/1000,12/1000,14/1000,16/1000,18/1000,20/1000};
pgtF = 0;
pitF = 0
pgtA = 0;
pgtB = 0;
pitA = 0;
pitB = 0;
omiga = 0.829;
c1 = 1.49;
c2 = 1.49;
vitA = {0,0,0,0,0,0};
vitB = {0,0,0,0,0,0};
miniA = 1/1000;
maxA = 5/1000;
miniB = 10/1000;
maxB = 30/1000;
function rand()
	local n = math.random(10000);
	return n/10000;
end

function init()
 print(&quot;call init&quot;);
 addVariate(&quot;RAAA&quot;,RAAA);
 addVariate(&quot;RBBB&quot;,RBBB);
end
function resultDataFilter()
 getAllResult();
 while(nextResult())
 do
	if(not openH5File())
	then
		print(&quot;open h5file false!&quot;);
	end
	if(not findResultData(&quot;test&quot;))
	then
		print(&quot;find result false!&quot;);
		return;
	end
 
	if(not openDataSet())
	then
		print(&quot;open data set false!&quot;);
		return;
	end
	local valueSize = getDataSetVlaueSize();
	local i = 0;
	local max = 0;
	local add = 0;
	local addCount = 0;
	while(i &lt; valueSize)
	do
		local time = getValue(i);
		if(time &gt; 1)
		then
			local value = getValue(i+1);
			addCount = addCount + 1;
			add = add + value;
			if(value &gt; max)
			then
				max = value;
			end
		end
		i = i + 2;
	end
	local av = add/addCount
	local f = av*math.exp(-math.abs(max/av - 2));
	print(&quot;f&quot;);
	print(f);
	addParam(f);
 end
end

function resultExpcet()
 print(&quot;call result expcet&quot;);
 if(pgtF &gt; 800000000)
 then
	return true;
 end
 return false;
end

function optimize()
 print(&quot;call optimize&quot;);
 local groupIndex = getHistorySize() - 1;
 local groupSize = getGroupSize(groupIndex);
 local index = 0;
 local maxF = 0;
 local maxFIndex = 0;
 while(index &lt; groupSize)
 do
	local F = getParam(groupIndex,index,0);
	print(&quot;F&quot;);
	print(F);
	if(F &gt; maxF)
	then
		maxF = F;
		maxFIndex = index;
	end
	if(F &gt; pgtF)
	then
		pgtF = F;
		pgtA = RAAA[index + 1];
		pgtB = RBBB[index + 1];
	end
	index = index + 1;
 end
 pitA = RAAA[maxFIndex + 1];
 pitB = RBBB[maxFIndex + 1];
 pitF = maxF;
 print(&quot;pgtF&quot;);
 print(pgtF);
 print(&quot;pitF&quot;);
 print(pitF);
 index = 1;
 while(index &lt; 7)
 do
	local temp = 0;
	temp = omiga*vitA[index] + c1*rand()*(pitA - RAAA[index]) + c2*rand()*(pgtA - RAAA[index]);
	vitA[index] = temp;
	RAAA[index] = RAAA[index] + temp;
	
	while(RAAA[index] &lt; miniA or RAAA[index] &gt; maxA)
	do
		if(RAAA[index] &lt; miniA)
		then
			RAAA[index] = miniA + math.abs(RAAA[index] - miniA);
		else
			RAAA[index] = maxA - math.abs(RAAA[index] - maxA);
		end
	end
	
	index = index + 1;	
 end
 index = 1;
 while(index &lt; 7)
 do
	local temp = 0;
	temp = omiga*vitB[index] + c1*rand()*(pitB - RBBB[index]) + c2*rand()*(pgtB - RBBB[index]);
	vitB[index] = temp;
	RBBB[index] = RBBB[index] + temp;
	
	while(RBBB[index] &lt; miniB or RBBB[index] &gt; maxB)
	do
		if(RBBB[index] &lt; miniB)
		then
			RBBB[index] = miniB + (math.abs(RBBB[index] - miniB));
		else
			RBBB[index] = maxB - math.abs(RBBB[index] - maxB);
		end
	end
	
	index = index + 1;
 end
 init();
end</string>
     </property>
    </widget>
